---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Publications">
  <h1 class="text-3xl font-semibold text-slate-900">Publications</h1>
  <p class="mt-2 text-slate-500">Articles, technical analysis, and presentations</p>

  <div class="mt-8">
    <p class="text-slate-600">
      Original technical writing on local LLM deployment, enterprise retrieval-augmented generation, AI evaluation, and leading AI adoption in large organizations is in development.
    </p>
    <p class="mt-4 text-slate-600">
      Each piece will include clear authorship attribution consistent with the entity identifier established on this site.
    </p>
  </div>
</Layout>
