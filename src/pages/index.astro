---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <section class="py-16">
    <p class="text-sm font-medium tracking-wide text-blue-700 uppercase">AI Engineering · Technology Leadership</p>
    <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight text-slate-900">
      Daniel Heiwig
    </h1>
    <p class="mt-6 text-xl text-slate-600 max-w-2xl">
      Building intelligent systems. Leading technological transformation.
    </p>
    <p class="mt-4 text-lg text-slate-600 max-w-2xl">
      AI engineer and technology leader focused on enterprise artificial intelligence, agentic systems, data modernization, and practical AI implementation.
    </p>
    <div class="mt-8 flex gap-4">
      <a href="/about" class="inline-flex items-center px-5 py-2.5 bg-slate-900 text-white text-sm font-medium rounded hover:bg-slate-800">
        About
      </a>
      <a href="/projects" class="inline-flex items-center px-5 py-2.5 border border-slate-300 text-sm font-medium rounded hover:bg-slate-50">
        Explore My Work
      </a>
    </div>
  </section>

  <section class="py-12 border-t border-slate-200">
    <h2 class="text-2xl font-semibold text-slate-900">Areas of Expertise</h2>
    <div class="mt-6 grid sm:grid-cols-2 gap-6">
      <div>
        <h3 class="font-medium text-slate-900">Enterprise AI</h3>
        <p class="mt-1 text-slate-600">Applied systems that connect emerging technology to operational outcomes.</p>
      </div>
      <div>
        <h3 class="font-medium text-slate-900">LLM & Agentic Systems</h3>
        <p class="mt-1 text-slate-600">Architecture, evaluation, and reliable deployment of autonomous AI capabilities.</p>
      </div>
      <div>
        <h3 class="font-medium text-slate-900">Data Modernization</h3>
        <p class="mt-1 text-slate-600">Integrating and structuring data for AI-enabled decision making.</p>
      </div>
      <div>
        <h3 class="font-medium text-slate-900">Technical Leadership</h3>
        <p class="mt-1 text-slate-600">Aligning technology strategy with organizational requirements.</p>
      </div>
    </div>
  </section>
</Layout>
