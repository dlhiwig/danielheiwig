---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
  <h1 class="text-3xl font-semibold text-slate-900">Contact</h1>
  <p class="mt-2 text-slate-500">Professional inquiries</p>

  <div class="mt-8 max-w-xl">
    <p class="text-slate-600">
      For professional inquiries, please reach out via the channels listed below. Personal contact information is not published on this site.
    </p>

    <ul class="mt-6 space-y-3">
      <li>
        <a href="https://github.com/dlhiwig" class="text-blue-700 hover:underline" target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </li>
      <li>
        <a href="https://x.com/DHiwig" class="text-blue-700 hover:underline" target="_blank" rel="noopener noreferrer">
          X (Twitter)
        </a>
      </li>
    </ul>

    <p class="mt-8 text-sm text-slate-500">
      A professional contact address will be added once domain and email infrastructure are configured.
    </p>
  </div>
</Layout>
