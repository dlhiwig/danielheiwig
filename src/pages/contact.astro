---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
  <h1 class="text-3xl font-semibold text-slate-900">Contact</h1>
  <p class="mt-2 text-slate-500">Connect with Daniel</p>

  <div class="mt-8 max-w-xl">
    <p class="text-slate-600">
      For professional connections, technical projects, and public updates, you can find me on the channels below. I keep my personal Facebook profile private and share public updates on my official page.
    </p>

    <ul class="mt-6 space-y-3">
      <li>
        <a href="https://github.com/dlhiwig" class="text-blue-700 hover:underline" target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </li>
      <li><a href="https://www.linkedin.com/in/danielheiwig/" class="text-blue-700 hover:underline" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a href="https://www.facebook.com/profile.php?id=61596691354369" class="text-blue-700 hover:underline" target="_blank" rel="noopener noreferrer">Public Facebook</a></li>
    </ul>

    <p class="mt-8 text-sm text-slate-500">
      A professional contact address will be added once domain and email infrastructure are configured.
    </p>
  </div>
</Layout>
